PROJECT_NAME="E-Schola Pro"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CONFIGURATION BASE DE DONNÉES CENTRALISÉE (PostgreSQL & Railway) ---
# 1. En Production sur Railway :
# Liez automatiquement le service PostgreSQL Railway via la variable de référence :
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
#
# 2. En Développement Local direct avec PostgreSQL Railway (TCP Proxy) :
# DATABASE_PUBLIC_URL="postgresql://postgres:PASSWORD@proxy_host.rlwy.net:PORT/railway"
#
# 3. En Développement Local autonome hors-ligne (SQLite) :
DATABASE_URL="sqlite:///./eschola.db"

# --- CONFIGURATION MESSAGERIE EMAIL (SMTP) ---
# Activez l'envoi d'emails réels (ex: Gmail, Brevo, SendGrid, Resend, Mailgun)
# Si SMTP_HOST est vide, le système bascule automatiquement en mode Dev/Mock (les emails sont journalisés sans erreur).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="contact@eschola.pro"
SMTP_FROM_NAME="E-Schola Pro"
SMTP_TLS=True
SMTP_SSL=False
EMAILS_ENABLED=False

# --- CLOUDINARY (Stockage médias & vidéos) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
