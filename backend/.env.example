PROJECT_NAME="E-Schola Pro"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CONFIGURATION BASE DE DONNÉES CENTRALISÉE (PostgreSQL & Railway) ---
# 1. En Production sur Railway :
# Liez automatiquement le service PostgreSQL Railway via la variable de référence :
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
#
# 2. En Développement Local direct avec PostgreSQL Railway (TCP Proxy) :
# DATABASE_PUBLIC_URL="postgresql://postgres:PASSWORD@proxy_host.rlwy.net:PORT/railway"
#
# 3. Connexion PostgreSQL obligatoire :
# DATABASE_URL="postgresql://postgres:PASSWORD@host:5432/railway"
# Note : Tout fallback vers SQLite ou des fichiers .db a été supprimé.

# --- CONFIGURATION MESSAGERIE EMAIL (SMTP SÉCURISÉ & DÉLIVRABILITÉ) ---
# Activez l'envoi d'emails réels (ex: Brevo, SendGrid, Amazon SES, Resend, Gmail SMTP, Mailgun)
# Si SMTP_HOST est vide, le système bascule automatiquement en mode Dev/Mock (les emails sont journalisés sans erreur).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="contact@eschola.pro"
SMTP_FROM_NAME="E-Schola Pro"
SMTP_REPLY_TO="support@eschola.pro"
SMTP_TLS=True
SMTP_SSL=False
SMTP_TIMEOUT=15
SMTP_ALLOW_INSECURE_TLS=False
EMAILS_ENABLED=False

# --- SÉCURITÉ CRYPTOGRAPHIQUE DKIM & ALIGNEMENT SPF / DMARC ---
# Configurez la signature DKIM applicative (RFC 6376) pour garantir 100% de délivrabilité sans spam.
# Générez une paire de clés RSA 2048-bit (ex: openssl genrsa -out dkim_private.pem 2048)
DKIM_DOMAIN="eschola.pro"
DKIM_SELECTOR="eschola"
DKIM_PRIVATE_KEY=""
DKIM_PRIVATE_KEY_PATH=""

# --- POLITIQUES DE VALIDATION DES DESTINATAIRES EXTERNES ---
# EMAIL_VALIDATE_MX : Vérifie la présence de serveurs MX/A DNS valides pour le domaine destinataire.
EMAIL_VALIDATE_MX=True
# BLOCK_DISPOSABLE_EMAILS : Rejette préventivement les adresses jetables/temporaires (ex: Mailinator, 10minutemail).
BLOCK_DISPOSABLE_EMAILS=True

# --- CLOUDINARY (Stockage médias & vidéos) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

